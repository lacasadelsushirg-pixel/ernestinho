{"id":"adega-perola","html":"<!doctype html>\n<html lang=\"es\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\" />\n    <title>Adega Pérola: guía completa | Ernestinho Carioca</title>\n    <meta\n      name=\"description\"\n      content=\"Guía completa de Adega Pérola en Copacabana: historia, ambiente, qué pedir, horarios, precios, mapa y consejos de Ernestinho Carioca.\"\n    />\n    <style>\n      :root {\n        --i: #0d1919;\n        --p: #123b3b;\n        --g: #e7b85c;\n        --c: #f6f0e6;\n        --m: #bac7c0;\n      }\n      * {\n        box-sizing: border-box;\n      }\n      body {\n        margin: 0;\n        background: var(--i);\n        color: var(--c);\n        font:\n          18px/1.7 Georgia,\n          serif;\n      }\n      a {\n        color: var(--g);\n      }\n      .back,\n      .wrap {\n        max-width: 1200px;\n        margin: auto;\n        padding: 20px 24px;\n      }\n      .hero {\n        min-height: 70vh;\n        padding: 7vw;\n        display: flex;\n        align-items: end;\n        background:\n          linear-gradient(90deg, #071313ee, #07131322),\n          url(\"https://res.cloudinary.com/qa301cbc/image/upload/v1788393680/adegaperola1.jpg\")\n            center/cover;\n      }\n      .hero h1 {\n        font-size: clamp(46px, 8vw, 96px);\n        line-height: 0.9;\n        margin: 14px 0;\n      }\n      .ey {\n        color: var(--g);\n        font: 700 12px Arial;\n        letter-spacing: 0.18em;\n        text-transform: uppercase;\n      }\n      .grid {\n        display: grid;\n        grid-template-columns: 1.4fr 0.8fr;\n        gap: 24px;\n      }\n      .card {\n        background: var(--p);\n        border: 1px solid #e7b85c44;\n        border-radius: 24px;\n        padding: 28px;\n        margin: 22px 0;\n        box-shadow:none!important;\n      }\n      .card h2 {\n        color: var(--g);\n        font-size: 30px;\n        margin-top: 0;\n      }\n      .facts {\n        font: 15px/1.8 Arial;\n        color: var(--m);\n      }\n      .facts strong {\n        color: var(--c);\n      }\n      .map {\n        width: 100%;\n        height: 350px;\n        border: 0;\n        border-radius: 16px;\n      }\n      .tags {\n        display: flex;\n        gap: 8px;\n        flex-wrap: wrap;\n      }\n      .tag {\n        border: 1px solid #e7b85c99;\n        color: var(--g);\n        padding: 5px 11px;\n        border-radius: 99px;\n        font: 12px Arial;\n      }\n      .btn {\n        display: inline-block;\n        background: var(--g);\n        color: #132222;\n        text-decoration: none;\n        padding: 10px 16px;\n        border-radius: 99px;\n        font: 700 13px Arial;\n        margin: 5px 3px 0 0;\n      }\n      .gallery {\n        display: grid;\n        grid-template-columns: repeat(3, 1fr);\n        gap: 14px;\n      }\n      .gallery figure {\n        margin: 0;\n        background: #071212;\n        border-radius: 16px;\n        overflow: hidden;\n      }\n      .gallery img {\n        width: 100%;\n        height: 280px;\n        object-fit: cover;\n        display: block;\n      }\n      .gallery figure:first-child {\n        grid-column: span 2;\n      }\n      .gallery figure:first-child img {\n        height: 430px;\n      }\n      .gallery figcaption {\n        padding: 9px 12px;\n        color: var(--m);\n        font: 12px Arial;\n      }\n      @media (max-width: 760px) {\n        .grid {\n          display: block;\n        }\n        .hero {\n          min-height: 62vh;\n          padding: 25px;\n        }\n        .wrap {\n          padding: 18px 14px;\n        }\n        .card {\n          padding: 21px;\n        }\n        .gallery {\n          grid-template-columns: 1fr 1fr;\n        }\n        .gallery figure:first-child {\n          grid-column: span 2;\n        }\n        .gallery img,\n        .gallery figure:first-child img {\n          height: 250px;\n        }\n        .map {\n          height: 290px;\n        }\n      }\n      .inline-photo {\n        margin: 26px 0;\n        border-radius: 18px;\n        overflow: hidden;\n        background: #071212;\n      }\n      .inline-photo img {\n        width: 100%;\n        max-height: 430px;\n        object-fit: cover;\n        display: block;\n      }\n      .inline-photo figcaption {\n        padding: 9px 13px;\n        color: var(--m);\n        font: 12px Arial;\n      }\n    </style>\n  </head>\n  <body>\n    <nav class=\"back\"><a href=\"index.html\">← Volver a Gastronomía</a></nav>\n    <header class=\"hero\">\n      <div>\n        <div class=\"ey\">Ernestinho Carioca · Copacabana</div>\n        <h1>Adega Pérola</h1>\n        <p>\n          Un boteco de Copacabana donde la barra, los productos del mar y el\n          ritmo del barrio son parte de la experiencia.\n        </p>\n      </div>\n    </header>\n    <main class=\"wrap\">\n      <div class=\"tags\">\n        <span class=\"tag\">Boteco</span><span class=\"tag\">Mariscos</span\n        ><span class=\"tag\">Sardinas</span><span class=\"tag\">Petiscos</span\n        ><span class=\"tag\">Económico</span>\n      </div>\n      <div class=\"grid\">\n        <section>\n          <article class=\"card\">\n            <h2>Identidad y ambiente visual</h2>\n            <p>\n              Adega Pérola tiene el lenguaje visual de un boteco de barra\n              estrecha y movimiento constante: vitrinas, porciones pequeñas,\n              cerveza fría y una sucesión de preparaciones del mar pensadas para\n              probar sin formalidad. Las fotografías transmiten proximidad y\n              abundancia, con una casa que se disfruta más mirando qué sale de\n              la cocina y conversando que buscando una puesta en escena\n              elegante.\n            </p>\n          </article>\n          <article class=\"card\">\n            <h2>Historia y propuesta</h2>\n            <p>\n              Adega Pérola tiene una lógica de boteco de barra y vitrina: se\n              mira, se elige y se arma una mesa de petiscos según el apetito del\n              momento. Sus pescados, sardinas, mariscos y conservas son más\n              importantes que cualquier decoración; la personalidad está en la\n              rotación de productos y en el movimiento del barrio.\n            </p>\n          </article>\n          <figure class=\"inline-photo\">\n            <img\n              src=\"https://res.cloudinary.com/qa301cbc/image/upload/v1789390742/adega_perola_sardinha.jpg\"\n              loading=\"lazy\"\n              alt=\"El ambiente y la identidad del restaurante\"\n            />\n            <figcaption>El ambiente y la identidad del restaurante</figcaption>\n          </figure>\n          <article class=\"card\">\n            <h2>Mi lectura personal como Ernestinho</h2>\n            <p>\n              Yo llevaría a un viajero a Adega Pérola para mostrarle una\n              Copacabana que no depende de la playa ni de los restaurantes de\n              mantel. La gracia está en elegir poco a poco, dejar que la mesa se\n              llene de sabores y entender que aquí la experiencia se construye\n              por bocados. Es una dirección para quien disfruta descubrir un\n              barrio a través de su boteco; si buscas silencio, servicio\n              ceremonial o una cena larga de platos individuales, elegiría otro\n              perfil.\n            </p>\n          </article>\n          <figure class=\"inline-photo\">\n            <img\n              src=\"https://res.cloudinary.com/qa301cbc/image/upload/v1789390742/adega_perola_2.jpg\"\n              loading=\"lazy\"\n              alt=\"Una preparación representativa de la casa\"\n            />\n            <figcaption>Una preparación representativa de la casa</figcaption>\n          </figure>\n          <article class=\"card\">\n            <h2>Qué pedir y por qué</h2>\n            <p>\n              Un boteco de Copacabana donde la barra, los productos del mar y el\n              ritmo del barrio son parte de la experiencia.\n            </p>\n          </article>\n          <article class=\"card\">\n            <h2>Experiencia según el momento del día</h2>\n            <p>\n              Horario y precios: confirmar antes de ir. La ficha turística de\n              Riotur informa teléfono +55 21 2255-9425.\n            </p>\n          </article>\n          <article class=\"card\">\n            <h2>Mi consejo específico</h2>\n            <p>\n              Yo no pediría un plato único. Haría una pequeña ronda: un pescado,\n              un marisco y algo para acompañar la cerveza, preguntando qué llegó\n              fresco ese día. Conviene aceptar que puede haber poco espacio y\n              bastante movimiento: aquí la informalidad es parte del encanto.\n            </p>\n          </article>\n          <article class=\"card\">\n            <h2>Qué combinar cerca</h2>\n            <p>\n              La combinaría con una caminata por Siqueira Campos y la playa de\n              Copacabana, especialmente después de la tarde. Es una parada\n              excelente antes de seguir hacia bares de la Zona Sul.\n            </p>\n          </article>\n        </section>\n        <aside>\n          <article class=\"card facts\">\n            <h2>Información práctica</h2>\n            <p>\n              📍 <strong>Dirección</strong><br />Rua Siqueira Campos, 138 —\n              Copacabana, Rio de Janeiro — RJ 22031-072\n            </p>\n            <p>\n              🕐 <strong>Horarios</strong><br />Horario y precios: confirmar\n              antes de ir. La ficha turística de Riotur informa teléfono +55 21\n              2255-9425.\n            </p>\n            <p>\n              💰 <strong>Precios</strong><br />Confirmar el valor vigente antes\n              de ir.\n            </p>\n            <p>\n              ☎️ <strong>Contacto</strong><br />Consultar canales oficiales.\n            </p>\n            <p>\n              🌐 <strong>Web / Instagram</strong><br /><a\n                href=\"https://www.instagram.com/adegaperola/\"\n                target=\"_blank\"\n                rel=\"noopener\"\n                >Abrir canal oficial</a\n              >\n            </p>\n            <a\n              class=\"btn\"\n              href=\"https://www.google.com/maps/search/?api=1&query=Adega%20P%C3%A9rola%20Rua%20Siqueira%20Campos%20138%20Copacabana%20Rio%20de%20Janeiro\"\n              target=\"_blank\"\n              rel=\"noopener\"\n              >🗺️ Google Maps</a\n            ><a\n              class=\"btn\"\n              href=\"https://www.waze.com/ul?q=Adega%20P%C3%A9rola%20Rua%20Siqueira%20Campos%20138%20Copacabana%20Rio%20de%20Janeiro\"\n              target=\"_blank\"\n              rel=\"noopener\"\n              >🚗 Waze</a\n            >\n          </article>\n          <figure class=\"inline-photo\">\n            <img\n              src=\"https://res.cloudinary.com/qa301cbc/image/upload/v1788393680/adegaperola1.jpg\"\n              loading=\"lazy\"\n              alt=\"La fachada y la llegada al restaurante\"\n            />\n            <figcaption>La fachada y la llegada al restaurante</figcaption>\n          </figure>\n          <article class=\"card\">\n            <h2>Mapa y cómo llegar</h2>\n            <p>\n              Consulta el mapa antes de salir y confirma la entrada correcta.\n            </p>\n            <iframe\n              class=\"map\"\n              loading=\"lazy\"\n              title=\"Mapa de Adega Pérola\"\n              src=\"https://www.google.com/maps?q=Adega%20P%C3%A9rola%20Rua%20Siqueira%20Campos%20138%20Copacabana%20Rio%20de%20Janeiro&output=embed\"\n            ></iframe>\n          </article>\n        </aside>\n      </div>\n      <article class=\"card\">\n        <h2>Galería completa</h2>\n        <p></p>\n        <div class=\"gallery\">\n          <figure>\n            <img\n              src=\"https://res.cloudinary.com/qa301cbc/image/upload/v1788393680/adegaperola1.jpg\"\n              loading=\"eager\"\n              alt=\"Adega Pérola: fotografía 1\"\n            />\n            <figcaption>Fotografía real · registro 1</figcaption>\n          </figure>\n          <figure>\n            <img\n              src=\"https://res.cloudinary.com/qa301cbc/image/upload/v1789390742/adega_perola_sardinha.jpg\"\n              loading=\"lazy\"\n              alt=\"Adega Pérola: fotografía 2\"\n            />\n            <figcaption>Fotografía real · registro 2</figcaption>\n          </figure>\n          <figure>\n            <img\n              src=\"https://res.cloudinary.com/qa301cbc/image/upload/v1789390742/adega_perola_2.jpg\"\n              loading=\"lazy\"\n              alt=\"Adega Pérola: fotografía 3\"\n            />\n            <figcaption>Fotografía real · registro 3</figcaption>\n          </figure>\n          <figure>\n            <img\n              src=\"https://res.cloudinary.com/qa301cbc/image/upload/v1789390742/adega_perola_4.jpg\"\n              loading=\"lazy\"\n              alt=\"Adega Pérola: fotografía 4\"\n            />\n            <figcaption>Fotografía real · registro 4</figcaption>\n          </figure>\n          <figure>\n            <img\n              src=\"https://res.cloudinary.com/qa301cbc/image/upload/v1789390741/adega_perola_6.jpg\"\n              loading=\"lazy\"\n              alt=\"Adega Pérola: fotografía 5\"\n            />\n            <figcaption>Fotografía real · registro 5</figcaption>\n          </figure>\n          <figure>\n            <img\n              src=\"https://res.cloudinary.com/qa301cbc/image/upload/v1789390741/adega_perola_3.jpg\"\n              loading=\"lazy\"\n              alt=\"Adega Pérola: fotografía 6\"\n            />\n            <figcaption>Fotografía real · registro 6</figcaption>\n          </figure>\n          <figure>\n            <img\n              src=\"https://res.cloudinary.com/qa301cbc/image/upload/v1789390741/adega_perola_5.jpg\"\n              loading=\"lazy\"\n              alt=\"Adega Pérola: fotografía 7\"\n            />\n            <figcaption>Fotografía real · registro 7</figcaption>\n          </figure>\n          <figure>\n            <img\n              src=\"https://res.cloudinary.com/qa301cbc/image/upload/v1789390741/adega_entrada.jpg\"\n              loading=\"lazy\"\n              alt=\"Adega Pérola: fotografía 8\"\n            />\n            <figcaption>Fotografía real · registro 8</figcaption>\n          </figure>\n        </div>\n      </article>\n    </main>\n    <footer class=\"back\">\n      © Ernestinho Carioca · Guía independiente de Río de Janeiro\n    </footer>\n  <style>.lang-switcher{position:fixed;z-index:9999;right:18px;top:18px;display:flex;gap:6px;background:#071313ef;padding:7px;border:1px solid #e7b85c;border-radius:999px}.lang-switcher button{border:0;border-radius:999px;padding:7px 10px;background:#123b3b;color:#f6f0e6;font:700 12px Arial;cursor:pointer}.lang-switcher button.active,.lang-switcher button:hover{background:#e7b85c;color:#132222}</style><script>(()=>{const T={\"pt\":{\"← Volver a Gastronomía\":\"← Voltar à Gastronomia\",\"Boteco\":\"Boteco\",\"Mariscos\":\"Frutos do mar\",\"Sardinas\":\"Sardinhas\",\"Petiscos\":\"Petiscos\",\"Económico\":\"Econômico\",\"Sandwiches\":\"Sanduíches\",\"Bar\":\"Bar\",\"Cocina brasileña\":\"Cozinha brasileira\",\"Madrugada\":\"Madrugada\",\"Precio medio\":\"Preço médio\",\"Rodízio\":\"Rodízio\",\"Carnes\":\"Carnes\",\"Buffet\":\"Buffet\",\"Premium\":\"Premium\",\"Comida brasileña\":\"Comida brasileira\",\"Pataniscas\":\"Pataniscas\",\"Chope\":\"Chope\",\"Identidad y ambiente visual\":\"Identidade e ambiente visual\",\"Historia y propuesta\":\"História e proposta\",\"El ambiente y la identidad del restaurante\":\"O ambiente e a identidade do restaurante\",\"Mi lectura personal como Ernestinho\":\"Minha leitura pessoal como Ernestinho\",\"Una preparación re