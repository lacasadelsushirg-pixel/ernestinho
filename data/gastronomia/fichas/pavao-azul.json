eplace(k,v):x.e.setAttribute(x.a,v)});document.querySelectorAll('.lang-switcher button').forEach(b=>b.classList.toggle('active',b.dataset.lang===l))}const b=document.createElement('nav');b.className='lang-switcher';[['es','ES'],['pt','PT'],['en','EN']].forEach(([l,t])=>{const x=document.createElement('button');x.dataset.lang=l;x.textContent=t;x.onclick=()=>setLang(l);b.appendChild(x)});document.body.prepend(b);setLang('es')})()</script><script>(function(){const D={\"pt\":{\"0\":\"Um boteco pequeno, direto e muito carioca, famoso pela cerveja gelada, pelos petiscos e pelo ambiente de Copacabana.\",\"1\":\"O Pavão Azul é reconhecido por sua estética direta de bar popular: mesas próximas, movimento da rua e uma energia que convida a sentar sem muita cerimônia. As fotos verticais de cerveja, porções e ambiente funcionam melhor quando são lidas como cenas espontâneas de Copacabana, não como um catálogo de alta gastronomia. É um lugar de conversa, petiscos e rotatividade natural de clientes.\",\"2\":\"O Pavão Azul é pequeno, direto e reconhecível pela energia de boteco concentrada ao redor de suas mesas. A casa não precisa de uma produção sofisticada: a cerveja, os petiscos e a conversa constroem o ambiente. As fotos verticais refletem melhor essa escala próxima e cotidiana.\",\"3\":\"O que me interessa no Pavão Azul é sua capacidade de transformar uma refeição simples em uma observação da vida do bairro. O visitante não vem em busca de uma experiência criada para impressionar, mas de um ponto de encontro onde sabor, preço e ambiente têm o mesmo peso. Eu o escolheria para uma tarde sem agenda rígida, especialmente se você quiser conhecer um boteco famoso por dentro e não apenas fotografar Copacabana a partir da orla.\",\"4\":\"Um boteco pequeno, direto e muito carioca, famoso pela cerveja gelada, pelos petiscos e pelo ambiente de Copacabana.\",\"5\":\"Todos os dias, das 12h à meia-noite, segundo a Riotur e o Instagram oficial. Telefones publicados: +55 21 3449-9419 / 2236-2381.\",\"6\":\"Eu chegaria fora do horário de maior movimento e pediria pataniscas de bacalhau para compartilhar, acompanhadas de uma bebida gelada. O erro seria esperar uma experiência silenciosa ou um serviço de restaurante formal; o Pavão Azul funciona graças à sua espontaneidade e ao ritmo da rua.\",\"7\":\"Eu combinaria a visita com uma caminhada pela Praça do Lido e pelo calçadão de Copacabana. Se o plano continuar em direção a Ipanema, funciona como uma parada curta e muito carioca antes de seguir.\",\"8\":\"📍 <strong>Endereço</strong><br />Rua Hilário de Gouveia, 71 — lojas A, B e C — Copacabana, Rio de Janeiro — RJ 22040-021\",\"9\":\"🕐 <strong>Horários</strong><br />Todos os dias, das 12h à meia-noite, segundo a Riotur e o Instagram oficial. Telefones publicados: +55 21 3449-9419 / 2236-2381.\",\"10\":\"💰 <strong>Preços</strong><br />Confirme o valor vigente antes de ir.\",\"11\":\"☎️ <strong>Contato</strong><br />Consulte os canais oficiais.\",\"12\":\"🌐 <strong>Site / Instagram</strong><br /><a href=\\\"https://www.instagram.com/pavaoazuloficial/\\\" target=\\\"_blank\\\" rel=\\\"noopener\\\">Abrir canal oficial</a>\",\"13\":\"Consulte o mapa antes de sair e confirme a entrada correta.\",\"14\":\"\"},\"en\":{\"0\":\"A small, straightforward and very Carioca boteco, famous for cold beer, snacks and its Copacabana atmosphere.\",\"1\":\"Pavão Azul is recognized by the direct look of a popular bar: closely spaced tables, street activity and an energy that invites you to sit down without much ceremony. Vertical photos of beer, portions and the setting work best when viewed as spontaneous Copacabana scenes rather than a fine-dining catalog. It is a place for conversation, snacks and a natural turnover of customers.\",\"2\":\"Pavão Azul is small, straightforward and recognizable for the boteco energy concentrated around its tables. It does not need a sophisticated production: beer, snacks and conversation create the atmosphere. The vertical photos best reflect this close, everyday scale.\",\"3\":\"What interests me about Pavão Azul is its ability to turn a simple meal into a chance to observe neighborhood life. Visitors do not come for an experience designed to impress, but for a meeting place where flavor, price and atmosphere carry equal weight. I would choose it for an afternoon without a rigid schedule, especially if you want to experience a well-known boteco from the inside rather than only photograph Copacabana from the waterfront.\",\"4\":\"A small, straightforward and very Carioca boteco, famous for cold beer, snacks and its Copacabana atmosphere.\",\"5\":\"Open daily from noon to midnight, according to Riotur and the official Instagram account. Published phone numbers: +55 21 3449-9419 / 2236-2381.\",\"6\":\"I would arrive outside the busiest period and order cod fritters to share with a cold drink. The mistake would be expecting a quiet experience or formal restaurant service; Pavão Azul works because of its spontaneity and street rhythm.\",\"7\":\"I would combine it with a walk through Praça do Lido and along the Copacabana waterfront. If your plans continue toward Ipanema, it makes a short and very Carioca stop before moving on.\",\"8\":\"📍 <strong>Address</strong><br />Rua Hilário de Gouveia, 71 — shops A, B and C — Copacabana, Rio de Janeiro — RJ 22040-021\",\"9\":\"🕐 <strong>Hours</strong><br />Open daily from noon to midnight, according to Riotur and the official Instagram account. Published phone numbers: +55 21 3449-9419 / 2236-2381.\",\"10\":\"💰 <strong>Prices</strong><br />Confirm the current price before visiting.\",\"11\":\"☎️ <strong>Contact</strong><br />Check the official channels.\",\"12\":\"🌐 <strong>Website / Instagram</strong><br /><a href=\\\"https://www.instagram.com/pavaoazuloficial/\\\" target=\\\"_blank\\\" rel=\\\"noopener\\\">Open official channel</a>\",\"13\":\"Check the map before leaving and confirm the correct entrance.\",\"14\":\"\"}},P=[...document.querySelectorAll('p')],O=P.map(e=>e.innerHTML);function full(l){P.forEach((e,i)=>{e.innerHTML=l==='es'?O[i]:(D[l]&&D[l][i]!==undefined?D[l][i]:e.innerHTML)})}document.querySelectorAll('.lang-switcher button').forEach(b=>b.addEventListener('click',()=>full(b.dataset.lang)));full('es')})();</script></body>\n</html>\n"}